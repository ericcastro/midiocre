{
  "name": "midiocre",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "postcss": "8.5.18",
    "sharp": "0.35.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "dev:backend": ".venv/bin/uvicorn backend.main:app --reload --port 8765",
    "dev:all": "concurrently -n web,api -c blue,green \"npm run dev\" \"npm run dev:backend\"",
    "dev:lan": "concurrently -n web,api -c blue,green \"npm run dev -- --hostname 0.0.0.0\" \"npm run dev:backend -- --host 0.0.0.0\"",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "check:secrets": "node scripts/check-secrets.mjs",
    "test": "npm run check:secrets && npm run build && .venv/bin/pytest && node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "lucide-react": "^1.26.0",
    "next": "^16.2.11",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tone": "^15.1.22"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "concurrently": "^10.0.4",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}

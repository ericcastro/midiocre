# The web app also accepts a one-session key from the settings panel.
OPENAI_API_KEY=

# Local Ollama defaults. Only loopback URLs are accepted by the backend.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional frontend override. Leave unset for normal local/LAN use so the API
# automatically follows the hostname used to open the web app.
# NEXT_PUBLIC_MIDI_TUTOR_API_URL=http://127.0.0.1:8765

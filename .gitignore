# Dependencies and package-manager state
/node_modules/
/.pnp/
.pnp.*
.yarn/*
!.yarn/patches/
!.yarn/plugins/
!.yarn/releases/
!.yarn/versions/

# Local configuration and credentials. The example is deliberately safe to commit.
.env
.env.*
!.env.example
.envrc
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
secrets/
credentials/

# Local MIDIocre library: uploaded MIDI, SQLite database, and analysis history.
/data/
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.db
*.db-wal
*.db-shm

# Python and JavaScript build output
/.venv/
/.venv-muscriptor/
/muscriptor-*.safetensors
/.pytest_cache/
__pycache__/
*.py[cod]
/.next/
/.vinext/
/dist/
/.wrangler/
/coverage/
/out/
*.tsbuildinfo

# Local tooling and operating-system files
/.vercel/
/outputs/
/work/
.DS_Store
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
